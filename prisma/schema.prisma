// PhishNetra - Prisma Schema Definition
// Milestone: 2 (Multi-Layer Intelligence)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("USER") // USER, ANALYST, ADMIN
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  analyses     Analysis[]

  @@map("users")
}

model Analysis {
  id                String             @id @default(uuid())
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  url               String
  normalizedUrl     String
  verdict           String             // SAFE, SUSPICIOUS, PHISHING, UNKNOWN
  riskScore         Float              // 0.0 to 100.0
  riskLevel         String             // LOW, MEDIUM, HIGH, CRITICAL
  confidence        Float              // 0.0 to 1.0
  mlProbability     Float              // 0.0 to 1.0
  status            String             @default("COMPLETED") // COMPLETED, FAILED, PARTIAL
  pageStatus        String?            @default("NOT_REQUESTED") // NOT_REQUESTED, COMPLETED, BLOCKED, TIMEOUT, FAILED, PARTIAL
  layersJson        String?            // Serialized multi-layer results (URL, Domain, DNS, TLS, Reputation, ML)
  layerStatusesJson String?            // Serialized layer status indicators
  pageAnalysisJson  String?            // Serialized page/content analysis findings (DOM, Forms, Brand, Redirects, etc.)
  summary           String?            // Human-readable Zero-Trust analysis summary
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  evidence          AnalysisEvidence[]

  @@index([userId])
  @@index([url])
  @@index([createdAt])
  @@map("analyses")
}

model AnalysisEvidence {
  id           String    @id @default(uuid())
  analysisId   String
  analysis     Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  layer        String    @default("URL") // URL, DOMAIN, DNS, TLS, REPUTATION, ML
  featureKey   String
  featureValue String
  severity     String    // INFO, LOW, MEDIUM, HIGH, CRITICAL
  description  String
  source       String?   @default("RuleEngine")
  confidence   Float?    @default(1.0)
  contribution Float?    @default(0.0)
  createdAt    DateTime  @default(now())

  @@index([analysisId])
  @@index([layer])
  @@map("analysis_evidence")
}
