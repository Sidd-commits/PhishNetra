# ==============================================================================
# PhishNetra - Environment Configuration Template (Milestone 1)
# ==============================================================================

# Node API Server
NODE_ENV=development
PORT=5000
API_HOST=localhost
CORS_ORIGIN=http://localhost:5173

# Authentication Secrets
JWT_SECRET=phishnetra_dev_jwt_secret_key_change_in_production_32char_min
JWT_EXPIRES_IN=7d

# PostgreSQL Database (Prisma)
# Example PostgreSQL Connection: postgresql://postgres:postgres@localhost:5432/phishnetra?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phishnetra?schema=public

# Python ML Inference Microservice
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend Web Application (apps/web)
VITE_API_URL=http://localhost:5000/api
